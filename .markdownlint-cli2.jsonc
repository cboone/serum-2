{
  "config": {
    // Line length: disabled. The prose here is written as one long line per
    // paragraph, with the editor handling visual wrapping.
    "MD013": false,

    // Allow duplicate headings in different sections (e.g. ## Notes).
    "MD024": { "siblings_only": true },

    // Allow inline HTML (<br>, <details>, <kbd>, etc.).
    "MD033": false,

    // Allow bare URLs without angle brackets.
    "MD034": false,

    // Table column style: disabled. Prettier owns table alignment; markdownlint
    // has no fixer for this rule.
    "MD060": false,
  },

  // Files to ignore
  "ignores": ["node_modules/", ".venv/", "CHANGELOG.md", "tests/scrut/"],
}
